<?xml version="1.0" encoding="utf-8"?>
<!-- Debug builds only (merged over src/main): the huddle foreground service is
     reachable from adb so the notification, the microphone service type and
     the audio route can be exercised on a device without a live huddle. The
     exact commands are in apps/android/README.md, "Huddles and mini apps".
     Release builds keep it exported="false". -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">
    <application>
        <service
            android:name=".HuddleService"
            android:exported="true"
            tools:replace="android:exported" />
    </application>
</manifest>
